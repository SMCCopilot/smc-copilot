# Copy to .env.local (git-ignored) and fill in. Never commit real values, never paste them into chat.
# Validated at boot by packages/config (Zod). In production the marked variables are required.

NODE_ENV=development
APP_ROLE=all
LOG_LEVEL=info
PORT=3000

# Database (Supabase). App queries use the transaction pooler (port 6543, prepare:false);
# migrations and pg-boss use the session pooler or direct URL.
# required in production
DATABASE_URL=
DATABASE_URL_SESSION=

# Supabase Auth (JWT verified through JWKS)
# required in production
SUPABASE_URL=
# required in production
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUD=authenticated

# Secrets (production: required)
# >= 32 chars
WS_TOKEN_SECRET=
ABUSE_HASH_SALT=
TURNSTILE_SECRET=

# Venues (defaults shown; spot and perp are separate hosts, decision D-004)
BINANCE_WS_URL=wss://data-stream.binance.vision
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_PERP_WS_URL=wss://fstream.binance.com/market
BINANCE_PERP_REST_URL=https://fapi.binance.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
BYBIT_REST_URL=https://api.bybit.com

# AI (Phase 5). Set hard spend limits in each vendor console as well.
ANTHROPIC_API_KEY=
FALLBACK_LLM_PROVIDER=
FALLBACK_LLM_API_KEY=
AI_MODEL_IMAGE_READ=
AI_MODEL_NARRATIVE=
AI_MODEL_CHAT=
AI_MODEL_ROUTER=
AI_MODEL_EXPLAIN=
AI_DAILY_BUDGET_DEFAULT_USD=0.05
AI_GLOBAL_DAILY_CAP_USD=10

# Live ingest from the venues (needs DATABASE_URL). Off by default.
INGEST_ENABLED=false
# Dev only: if your network blocks venue hosts, resolve through these DNS servers, e.g. 1.1.1.1,8.8.8.8
DNS_SERVERS=

# Observability and hardening
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
# comma separated
ADMIN_IP_ALLOWLIST=
# comma separated; required in production
CORS_ORIGINS=
