# SMC Copilot environment. Copy to .env.local for local work (git-ignored) and set the same names as
# Railway service variables for production. Never commit real values and never paste them into chat.
# Validated at boot by packages/config: with NODE_ENV=production the marked variables are REQUIRED and the app
# refuses to start without them (it prints the missing variable names, never values).

# ---------------------------------------------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------------------------------------------
# development locally, production on Railway. If unset the app assumes production (fail closed).
NODE_ENV=development
# all = API + background work in one process (the MVP). Railway sets PORT itself; leave it unset there.
APP_ROLE=all
LOG_LEVEL=info
PORT=3000

# ---------------------------------------------------------------------------------------------------------------
# Database: Supabase (Project Settings -> Database -> Connection string)
# ---------------------------------------------------------------------------------------------------------------
# REQUIRED in production. Transaction pooler URL (port 6543). The app turns prepared statements off for it.
DATABASE_URL=
# REQUIRED in production. Session pooler URL (port 5432 on the pooler host) or the direct URL. Used by migrations
# and the job queue. If your host has no IPv6, use the session pooler (IPv4).
DATABASE_URL_SESSION=

# ---------------------------------------------------------------------------------------------------------------
# Supabase Auth (Project Settings -> API)
# ---------------------------------------------------------------------------------------------------------------
# REQUIRED in production. https://<project-ref>.supabase.co
SUPABASE_URL=
# REQUIRED in production. https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=
SUPABASE_JWT_AUD=authenticated

# ---------------------------------------------------------------------------------------------------------------
# Secrets you generate yourself (any password manager; e.g. `openssl rand -base64 48`)
# ---------------------------------------------------------------------------------------------------------------
# REQUIRED in production, at least 32 characters. Signs the 5-minute WebSocket tokens.
WS_TOKEN_SECRET=
# REQUIRED in production, at least 16 characters. Salt for hashed per-IP/device abuse counters.
ABUSE_HASH_SALT=
# REQUIRED in production. Cloudflare Turnstile secret key (free; dash.cloudflare.com -> Turnstile). Used from Phase 4.
TURNSTILE_SECRET=

# ---------------------------------------------------------------------------------------------------------------
# Web access
# ---------------------------------------------------------------------------------------------------------------
# REQUIRED in production. Exact browser origins allowed to call the API, comma separated, no wildcard,
# e.g. https://app.example.com
CORS_ORIGINS=
# Admin endpoints: comma separated IPs or CIDR ranges allowed to call /v1/admin. Empty in production means
# admin calls are refused. (Railway forwards the caller address in X-Forwarded-For; support for that header is
# added in Phase 9 before admin is used in production.)
ADMIN_IP_ALLOWLIST=
# true only when the API sits behind a proxy that overwrites the client-address header. Leave false on Railway
# until Phase 9 wires X-Forwarded-For handling.
TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------------------------------------------
# Market data (public venue feeds, no keys needed). Defaults are correct; change only if a venue moves.
# ---------------------------------------------------------------------------------------------------------------
# Live ingest from Binance and Bybit. true on Railway and when you want live data locally.
INGEST_ENABLED=false
# Dev only, never in production: resolve names through these DNS servers when your network blocks the exchanges,
# e.g. 1.1.1.1,8.8.8.8
DNS_SERVERS=
BINANCE_WS_URL=wss://data-stream.binance.vision
BINANCE_REST_URL=https://data-api.binance.vision
BINANCE_PERP_WS_URL=wss://fstream.binance.com/market
BINANCE_PERP_REST_URL=https://fapi.binance.com
BYBIT_WS_URL=wss://stream.bybit.com/v5/public/linear
BYBIT_REST_URL=https://api.bybit.com

# ---------------------------------------------------------------------------------------------------------------
# AI (used from Phase 5). Also set a hard monthly spend limit in each vendor's console.
# ---------------------------------------------------------------------------------------------------------------
ANTHROPIC_API_KEY=
# A second vendor used when the first is down (provider name, e.g. google, openai) and its key.
FALLBACK_LLM_PROVIDER=
FALLBACK_LLM_API_KEY=
# Model ids as configuration, so models can change without a deploy.
AI_MODEL_IMAGE_READ=
AI_MODEL_NARRATIVE=
AI_MODEL_CHAT=
AI_MODEL_ROUTER=
AI_MODEL_EXPLAIN=
# Per-user daily AI budget in USD, and the global daily cap that trips the kill switch.
AI_DAILY_BUDGET_DEFAULT_USD=0.05
AI_GLOBAL_DAILY_CAP_USD=10

# ---------------------------------------------------------------------------------------------------------------
# Observability (optional)
# ---------------------------------------------------------------------------------------------------------------
# Sentry project DSN (free plan).
SENTRY_DSN=
# OpenTelemetry collector endpoint, if you run one.
OTEL_EXPORTER_OTLP_ENDPOINT=
