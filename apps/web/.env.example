# Optional overrides. By default next.config.mjs reads the repo-root .env.local (PORT, SUPABASE_URL, SUPABASE_ANON_KEY).
# Only public values reach the browser. Set the Turnstile SITE key (not the secret) here or in the root .env.local.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
