{
  "name": "smc-copilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check . && pnpm lint:boundaries",
    "lint:boundaries": "node tools/boundaries/src/cli.mjs",
    "format": "biome check --write .",
    "prepare": "lefthook install",
    "engine:replay": "node tools/engine/src/replay.mjs",
    "engine:label-pack": "node tools/engine/src/label-pack.mjs",
    "engine:fidelity": "node tools/engine/src/fidelity-cli.mjs",
    "engine:fetch-history": "node tools/engine/src/fetch-history.mjs",
    "engine:backtest": "node tools/engine/src/backtest.mjs",
    "ai:eval": "node tools/ai-eval/src/eval.mjs",
    "ai:session-hour": "node tools/ai-eval/src/session-hour.mjs",
    "voice:pin-models": "node tools/voice-eval/src/pin-models.mjs",
    "voice:eval": "node tools/voice-eval/src/eval.mjs",
    "api": "node tools/dev/src/local.mjs api",
    "local": "node tools/dev/src/local.mjs",
    "ops:preflight": "node tools/ops/src/preflight.mjs",
    "ops:backup": "node tools/ops/src/backup.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.5.0",
    "lefthook": "^2.2.1",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "vitest": "^5.0.5"
  }
}
