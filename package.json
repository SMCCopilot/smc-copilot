{
  "name": "smc-copilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "lint": "biome check . && pnpm lint:boundaries",
    "lint:boundaries": "node tools/boundaries/src/cli.mjs",
    "format": "biome check --write .",
    "prepare": "lefthook install",
    "engine:replay": "node tools/engine/src/replay.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "^22.20.5",
    "dependency-cruiser": "^18.5.0",
    "lefthook": "^2.2.1",
    "turbo": "^2.11.7",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
