{
  "name": "@smc/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist",
    "migrations",
    "sql-tests"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "biome check .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "node dist/cli/migrate.js",
    "db:smoke": "node dist/cli/smoke.js"
  },
  "dependencies": {
    "@smc/contracts": "workspace:*",
    "postgres": "^3.4.9"
  },
  "devDependencies": {
    "embedded-postgres": "17.10.0-beta.17"
  }
}
